`NEC-like SMARCA4 ARID1A` = "NEC-like SMARCA4/ARID1A-deficient carcinoma",
`ALV RMS` = "Alveolar rhabdomyosarcoma",
ACC = "Adenoid cystic carcinoma",
ADC = "Sinonasal adenocarcinoma",
`PIT AD` = "Pituitary adenoma",
CPH = "Craniopharyngioma",
EWS = "Ewing sarcoma",
ONB = "Olfactory neuroblastoma",
SCC = "Squamous cell carcinoma",
`NEC-like IDH2` = "NEC-like IDH2-mutant carcinoma",
`EMB RMS` = "Embryonal rhabdomyosarcoma",
NUT = "NUT carcinoma",
MCC = "Mucoepidermoid")
edges_1 <- df %>% count(source = "Total", target = Group, name = "value")
edges_2 <- df %>% count(source = Group, target = `QC Flag`, name = "value")
edges_3 <- df %>% count(source = `QC Flag`, target = `Confidence Tier`, name = "value")
edges_4 <- df %>% count(source = `Confidence Tier`, target = Classification, name = "value")
links <- bind_rows(edges_1, edges_2, edges_3, edges_4)
links <- links %>%
mutate(
source = recode(source, !!!label_map),
target = recode(target, !!!label_map)
)
nodes <- data.frame(name = unique(c(links$source, links$target)))
links$IDsource <- match(links$source, nodes$name) - 1
links$IDtarget <- match(links$target, nodes$name) - 1
sankeyNetwork(
Links = links,
Nodes = nodes,
Source = "IDsource",
Target = "IDtarget",
Value = "value",
NodeID = "name",
fontSize = 20,
fontFamily = "Helvetica",
nodeWidth = 20,
sinksRight = FALSE
)
