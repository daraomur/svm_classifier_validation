library(DiagrammeR)
grViz("
digraph pipeline {
graph [rankdir = TB, fontname = Helvetica]
node [shape = box, style = filled, fillcolor = '#E6F1FB', fontname = Helvetica, fontsize = 12, ]
B [label = <<B>SeSAMe</B><BR/>Preprocessing (QCDPB)>]
C [label = <<B>Quality Control</B><BR/>GCT &gt; 1.5; Frac NA &gt; 0.2>]
F [label = <<B>Classifier</B><BR/>Jurmeister et al. 18-class SVM>]
G [label = <<B>Confidence scoring</B><BR/>Capper et al. Classification tiers>]
B -> C -> F -> G
}
")
